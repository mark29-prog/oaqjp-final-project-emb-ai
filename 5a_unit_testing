"""
Unit tests for EmotionDetection application
"""

from EmotionDetection import emotion_detector

def test_emotion_detection():
    """
    Runs unit tests on emotion detection function.
    """

    test_cases = {
        "I am glad this happened": "joy",
        "I am really mad about this": "anger",
        "I feel disgusted just hearing about this": "disgust",
        "I am so sad about this": "sadness",
        "I am really afraid that this will happen": "fear"
    }

    print("Running Emotion Detection Unit Tests...\n")

    for text, expected_emotion in test_cases.items():
        result = emotion_detector(text)
        actual_emotion = result["dominant_emotion"]

        print(f"Text: {text}")
        print(f"Expected: {expected_emotion}, Got: {actual_emotion}")

        assert actual_emotion == expected_emotion, f"Test failed for: {text}"
        print("Test Passed ✅\n")

    print("All tests passed successfully 🎉")

if __name__ == "__main__":
    test_emotion_detection()
