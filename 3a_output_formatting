"""
Emotion Detection Module

This module provides a function to analyze emotions in a given text
using the Watson NLP Emotion Predict API.
"""

import requests
import json

def emotion_detector(text_to_analyze):
    """
    Analyzes the emotion of the provided text.

    Args:
        text_to_analyze (str): The text to analyze.

    Returns:
        dict: A dictionary containing emotion scores and dominant emotion.
    """

    # API endpoint
    url = "https://sn-watson-emotion.labs.skills.network/v1/watson.runtime.nlp.v1/NlpService/EmotionPredict"

    # Headers
    headers = {
        "grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock"
    }

    # Input JSON
    input_json = {
        "raw_document": {
            "text": text_to_analyze
        }
    }

    try:
        # Send POST request
        response = requests.post(url, headers=headers, json=input_json)

        # Raise exception for HTTP errors
        response.raise_for_status()

        # Convert response text to dictionary
        response_dict = json.loads(response.text)

        # Extract emotion scores
        emotions = response_dict["emotionPredictions"][0]["emotion"]

        anger = emotions["anger"]
        disgust = emotions["disgust"]
        fear = emotions["fear"]
        joy = emotions["joy"]
        sadness = emotions["sadness"]

        # Determine dominant emotion
        dominant_emotion = max(emotions, key=emotions.get)

        # Return formatted result
        return {
            "anger": anger,
            "disgust": disgust,
            "fear": fear,
            "joy": joy,
            "sadness": sadness,
            "dominant_emotion": dominant_emotion
        }

    except requests.exceptions.RequestException as e:
        return {"error": f"Request failed: {str(e)}"}

    except (KeyError, IndexError, json.JSONDecodeError) as e:
        return {"error": f"Response parsing failed: {str(e)}"}
